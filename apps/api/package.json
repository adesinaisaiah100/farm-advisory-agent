{
  "name": "@poultry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integ": "echo 'no integration tests yet' && exit 0"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@poultry/core": "workspace:*",
    "@poultry/schemas": "workspace:*",
    "@poultry/stores": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}