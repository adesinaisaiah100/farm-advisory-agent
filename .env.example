# --- Environment template -----------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is the only
# committed env file. Never paste a real key into this file.
#
#   cp .env.example .env
#
# Anything in here that the code needs at boot gets validated by a Zod env schema,
# so a missing or malformed value fails loudly at startup rather than mid-demo.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Google AI Studio (the only key the MVP needs) ----------------------------
# Free tier: no credit card required. One key covers the turn, the transcription
# and the embeddings.
GEMINI_API_KEY=

# Turn, tool calling and vision. Free tier supports function calling, structured
# outputs, and text/image/video/audio input at 1M context.
GEMINI_MODEL=gemini-3.1-flash-lite

# Ingestion only: turning a whole source document into typed regions. This is the
# one reasoning-heavy call in the system and it runs rarely (per document, not per
# turn), so it runs on the stronger model rather than the cheap one.
GEMINI_INGEST_MODEL=gemini-2.5-flash

# Word-for-word transcription of Pidgin voice notes. A transcription model, not a
# reasoning model: reasoning models paraphrase, and farmer speech is evidence that
# must survive verbatim.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Embeddings. `text-embedding-004` is deprecated; this is the documented text
# replacement. 3072 dims natively, truncated to 768 via MRL below.
GEMINI_EMBED_MODEL=gemini-embedding-001
# 768 is the width the chunks table is built for. Do not change without a migration.
GEMINI_EMBED_DIMS=768
# CRITICAL: gemini-embedding-001 does NOT auto-normalize after MRL truncation.
# pgvector's cosine distance is scale-invariant, so this is NOT about ranking
# quality — it is that the in-memory pgvector double used by unit tests must
# compute the same number the database does, and so that switching the HNSW
# opclass to inner product or L2 later cannot silently change results. Forget it
# and nothing throws; the tests just stop describing production. The embedder
# normalizes in code; see packages/rag/src/embed.
GEMINI_EMBED_NORMALIZE=true

# --- Database: Neon (Postgres + pgvector) -------------------------------------
# Populated automatically by the Neon CLI (`neon link` / `neon deploy`), and
# `neon env` rewrites these. Do not hand-edit the values.
# TWO strings, deliberately. The pooled endpoint (hostname has -pooler) is the
# runtime one. The direct/unpooled endpoint is required for schema migrations:
# Neon runs PgBouncer in transaction mode, so SET, LISTEN/NOTIFY and SQL PREPARE
# do not work on the pooled endpoint, and Drizzle uses prepared statements.
# These names are the ones the CLI and @neon/env read, so they are not renamed.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Enable before the first migration, in the Neon SQL editor:
#   CREATE EXTENSION IF NOT EXISTS vector;
#
# This project's branches set suspend_timeout_seconds = 0, so they do NOT scale
# to zero and there is no cold-start penalty to warm around. Re-check that
# setting if the project is ever recreated on a plan that forces suspension.

# --- WhatsApp bridge (Baileys) ------------------------------------------------
# Comma-separated E.164 numbers permitted to drive the agent. Everything else is
# ignored, so a stranger messaging the demo number cannot move the conversation.
BRIDGE_ALLOWED_FROM=
# Where the linked-device session lives. This holds account credentials: it is
# gitignored and must never be committed or shared.
BRIDGE_SESSION_DIR=./.bridge-session

# --- Optional fallback: OpenRouter free tier ----------------------------------
# Unused on the happy path. Kept because the free pool is rate-limited, so a 429
# on the primary model is survivable if there is somewhere else to go. Any model
# used here must accept audio and must not be a reasoning model. Free models with
# audio: thinkingmachines/inkling:free, thinkingmachines/inkling-small:free,
# nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free (reasoning: transcribes by
# summarising, so avoid it for verbatim audio).
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=

# --- Object storage: Cloudflare R2 (media, phase 6) --------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Media integration fixtures (optional overrides) ---------------------------
# `pnpm test:integ` runs against the committed real-media fixtures in
# packages/media/tests/fixtures, so these are only needed to close the two gaps
# documented in that directory's README: a real Pidgin voice note and a photo of
# a visibly unwell bird. See that README before assuming the run proves more
# than it does.
# PIDGIN_FIXTURE_AUDIO=C:\fixtures\pidgin-voice-note.m4a
# PHOTO_FIXTURE_IMAGE=C:\fixtures\unwell-hen.jpg

# --- Observability (optional) -------------------------------------------------
# Langfuse is what answers "why did the agent say that?" during review.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
