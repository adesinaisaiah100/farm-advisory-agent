{
  "name": "poultry-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:unit": "pnpm -r --workspace-concurrency=1 test:unit",
    "test:integ": "pnpm -r --workspace-concurrency=1 test:integ",
    "bridge": "pnpm --dir apps/bridge start",
    "bridge:check": "pnpm --dir apps/bridge typecheck && pnpm --dir apps/bridge lint && pnpm --dir apps/bridge test:unit",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm bridge:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^2.1.0"
  }
}