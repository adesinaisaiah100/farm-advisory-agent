# --- Node / pnpm ---
node_modules/
*.tgz
.pnpm-store/

# --- Build output ---
dist/
build/
*.tsbuildinfo
.wrangler/
.dev.vars

# --- Coverage ---
coverage/

# --- Env & secrets ---
.env
.env.*
!.env.example

# --- WhatsApp bridge session (device identity / account access) ---
# Baileys writes the linked-device credentials here. Committing it hands over
# the WhatsApp account, so it is ignored by directory AND by known filenames.
.bridge-session*/
*.session.json
auth_info.json
creds.json

# --- Tests ---
tests/*.tmp/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# --- Neon branch data / local scratch ---
*.sqlite
*.db
.neon
