# Production Dockerfile for BirdVet API (apps/api)
FROM node:22-alpine

# Install pnpm matching packageManager in package.json
RUN npm install -g pnpm@12.6.0

WORKDIR /app

# Copy root workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./

# Copy packages and apps required by the workspace
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY apps/web/ ./apps/web/

# Install dependencies across the workspace
RUN pnpm install --frozen-lockfile

# Default environment configuration
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:${PORT}/health || exit 1

# Start Hono API server
CMD ["pnpm", "--dir", "apps/api", "start"]
